# Nunca coloque estas chaves no index.html ou no Git.
GEMINI_API_KEY=cole_a_chave_do_provider_aqui
GEMINI_MODEL=gemini-3.6-flash
# Fase de teste: acesso livre. Altere para false apenas quando existir pagamento no servidor.
ALLOW_DIRECT_ANALYSIS=true
# Acesso gratuito do proprietário: nunca colocar estes valores no site ou no Git.
ANALYSIS_ACCESS_CODE=crie_um_codigo_longo_e_unico
ANALYSIS_SESSION_SECRET=crie_um_segredo_com_pelo_menos_32_caracteres

# Envio do relatório em PDF pelo Resend. Nunca publicar estes valores no Git.
RESEND_API_KEY=re_xxxxxxxxx
REPORT_FROM_EMAIL=Relatórios PDM <relatorios@o_seu_dominio.pt>
# Opcional: recebe uma cópia oculta de cada relatório enviado.
REPORT_OWNER_EMAIL=geral@leonelmendes.com

# Consulta de disponibilidade do Google Calendar para reuniões. Nunca publicar a chave JSON no Git.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"site-agendamentos@projeto.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
GOOGLE_CALENDAR_ID=48arqt@gmail.com
MEETING_DURATION_MINUTES=60

# Métricas operacionais e limite futuro do trial. A base Netlify Database cria
# normalmente NETLIFY_DATABASE_URL automaticamente; não publique este valor.
# Enquanto ENFORCE_TRIAL_LIMIT=false, o site continua em trial livre e apenas
# mede pedidos concluídos, tokens e duração sem guardar e-mails em claro.
# Netlify Database nativa usa NETLIFY_DB_URL. Não criar/copiar manualmente:
# é preenchida pela Netlify ao associar uma base pelo menu Data & Storage.
NETLIFY_DB_URL=postgresql://utilizador:password@host/base
# Compatibilidade com integração Neon/variável usada em versões anteriores.
NETLIFY_DATABASE_URL=postgresql://utilizador:password@host/base
ENFORCE_TRIAL_LIMIT=false
TRIAL_MAX_ANALYSES=3

# Ligação vetorial oficial ao PDM de Faro (preencher apenas após confirmação da entidade publicadora).
# Preferência: WFS público com atributos de classe/categoria/subcategoria.
FARO_PDM_WFS_URL=https://servidor-oficial.exemplo.pt/geoserver/wfs
FARO_PDM_WFS_TYPENAME=espaco_de_nomes:planta_ordenamento
# Alternativa para ArcGIS Feature/Map Service com endpoint /query.
FARO_PDM_ORDERING_QUERY_URL=https://servidor-oficial.exemplo.pt/arcgis/rest/services/PDM/FeatureServer/0/query
